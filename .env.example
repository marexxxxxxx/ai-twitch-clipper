# AI Twitch Clipper — Beispielkonfiguration
# Kopieren nach .env und anpassen.

# Wurzelverzeichnis für Aufnahmen (im Container /data, per Volume gemappt)
STORAGE_ROOT=/data

# Ablage der SQLite-Datenbank (sollte auf einem persistenten Volume liegen)
DATA_DIR=/data

# HTTP-Port im Container
PORT=8000

# Zeitzone nur für die Anzeige; intern wird durchgängig UTC gerechnet
TZ=Europe/Berlin

# Log-Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Standardqualität für streamlink (Kandidatenliste, erster verfügbarer gewinnt)
QUALITY=720p60,best

# Optional: Twitch-Helix (App-Token). Ohne diese Werte läuft der anonyme GraphQL-Modus.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
